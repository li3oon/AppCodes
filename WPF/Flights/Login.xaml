<Page x:Class="Flights.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Flights"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Login">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBox  Name="UserLogin" VerticalAlignment="Bottom" Grid.Row="0" Height="50" Width="200" FontSize="14"/>
        <PasswordBox Name="UserPassword" VerticalAlignment="Bottom" Grid.Row="2" Height="50" Width="200" FontSize="14"/>
        <Button FontSize="14" Name="BtnLogin" Content="Войти" Grid.Row="4" Height="50" Width="200" VerticalAlignment="Top" Click="BtnLogin_Click"/>
    </Grid>
</Page>
