<Page x:Class="Flights.ListTrips"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Flights"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ListTrips" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="TripGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№ рейса" Binding="{Binding ID}" Width="65"/>
                <DataGridTextColumn Header="Пункт отправления" Binding="{Binding Direction.DeparturePoint}" Width="*"/>
                <DataGridTextColumn Header="Пункт прибытия" Binding="{Binding Direction.ArrivalPoint}" Width="*"/>
                <DataGridTextColumn Header="Дата отправления" Binding="{Binding DepartureDate}" Width="*"/>
                <DataGridTextColumn Header="Дата прибытия" Binding="{Binding ArrivalDate}" Width="*"/>
                <DataGridTextColumn Header="Самолет" Binding="{Binding Airplane}" Width="58"/>
                <DataGridTemplateColumn Width="auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактирование" Name="BtnEdit" Click="BtnEdit_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <DatePicker Width="100" Grid.Row="0" SelectedDateChanged="EndDatePicker_SelectedDateChanged" Name="end" Margin="424,5,226,5"></DatePicker>
        <DatePicker Width="100" Grid.Row="0" SelectedDateChanged="StartDatePicker_SelectedDateChanged" Name="start" Margin="225,5,425,5"></DatePicker>
        <TextBlock Grid.Row="0" Text="Сортировка по датам:   c" VerticalAlignment="Center" Margin="10,0,500,0"></TextBlock>
        <TextBlock Grid.Row="0" Text="по" VerticalAlignment="Center" Width="17" HorizontalAlignment="Center"></TextBlock>

        <Button FontSize="14" HorizontalAlignment="Left" Width="200" Grid.Row="2" Name="BtnAdd" Click="BtnAdd_Click"  Content="Добавить"/>
        <Button FontSize="14" HorizontalAlignment="Right" Width="200" Grid.Row="2" Name="BtnDel" Click="BtnDel_Click" Content="Удалить"/>

    </Grid>
</Page>
