<Page x:Class="Flights.ListTicket"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Flights"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ListTicket">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="TicketGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№ билета" Binding="{Binding ID}" Width="65"/>
                <DataGridTextColumn Header="Код билета" Binding="{Binding TicketCode}" Width="*"/>
                <DataGridTextColumn Header="Класс" Binding="{Binding Class}" Width="45"/>
                <DataGridTextColumn Header="Место" Binding="{Binding Place}" Width="45"/>
                <DataGridTemplateColumn Header="Маршрут" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} - {1}">
                                        <Binding Path="Trip.Direction.DeparturePoint" />
                                        <Binding Path="Trip.Direction.ArrivalPoint" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Дата отправления" Binding="{Binding Trip.DepartureDate}" Width="*"/>
                <DataGridTextColumn Header="Дата прибытия" Binding="{Binding Trip.ArrivalDate}" Width="*"/>
                <DataGridTextColumn Header="Самолет" Binding="{Binding Trip.Airplane}" Width="58"/>
                <DataGridTemplateColumn Header="ФИО покупателя" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} {1} {2}">
                                        <Binding Path="Customer.LastName" />
                                        <Binding Path="Customer.FirstName" />
                                        <Binding Path="Customer.Patronymic" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Цена" Binding="{Binding Cost}" Width="65"/>
            </DataGrid.Columns>
        </DataGrid>

        <DatePicker Width="100" Grid.Row="0" SelectedDateChanged="EndDatePicker_SelectedDateChanged" Name="end" Margin="424,5,226,5"></DatePicker>
        <DatePicker Width="100" Grid.Row="0" SelectedDateChanged="StartDatePicker_SelectedDateChanged" Name="start" Margin="225,5,425,5"></DatePicker>
        <TextBlock Grid.Row="0" Text="Сортировка по датам:   c" VerticalAlignment="Center" Margin="10,0,500,0"></TextBlock>
        <TextBlock Grid.Row="0" Text="по" VerticalAlignment="Center" Width="17" HorizontalAlignment="Center"></TextBlock>

        <ComboBox Grid.Row="0" Width="200" Height="30" FontSize="14" Name="filter" VerticalAlignment="Center" HorizontalAlignment="Right" SelectionChanged="Filter_SelectionChanged" DisplayMemberPath="RouteName" SelectedValuePath="ID"/>
    </Grid>
</Page>
