<Page x:Class="Flights.AddEditListTrips"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Flights"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddEditListTrips">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Номер рейса:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="0" Grid.Column="0"/>
        <TextBox Name="TripID" Text=" {Binding ID}" Grid.Row="0" Grid.Column="1" Width="400" Height="40" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10 0 0 0"/>

        <TextBlock Text="Маршрут:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="1" Grid.Column="0"/>
        <ComboBox x:Name="ComboDirection"
          Grid.Row="1" Grid.Column="1"
          Width="400" Height="80" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10 0 0 0"
          SelectedItem="{Binding Direction, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="6">
                        <StackPanel Orientation="Vertical">
                            <TextBlock FontWeight="Bold" Text="{Binding ID, StringFormat=Маршрут {0}}"/>
                            <TextBlock Text="{Binding DeparturePoint, StringFormat=От: {0}}"/>
                            <TextBlock Text="{Binding ArrivalPoint, StringFormat=До: {0}}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="Дата отправления:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="2" Grid.Column="0"/>
        <DatePicker x:Name="DepartureDatePicker" SelectedDate="{Binding DepartureDate, Mode=TwoWay}" Grid.Row="2" Grid.Column="1" Width="400" Height="40" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10 0 0 0"/>

        <TextBlock Text="Дата прибытия:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="3" Grid.Column="0"/>
        <DatePicker x:Name="ArrivalDatePicker" SelectedDate="{Binding ArrivalDate, Mode=TwoWay}" Grid.Row="3" Grid.Column="1" Width="400" Height="40" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10 0 0 0"/>

        <TextBlock Text="Самолет:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="4" Grid.Column="0"/>
        <TextBox Name="NameAirplane" Text="{Binding Airplane, Mode=TwoWay}" Grid.Row="4" Grid.Column="1" Width="400" Height="40" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10 0 0 0"/>

        <Button Content="Сохранить" Grid.Row="6" Grid.ColumnSpan="2" Width="100" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" Click="BtnSave_Click"/>
    </Grid>
</Page>
