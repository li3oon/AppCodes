<Window x:Class="Automation_Of_Bus_Routes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Automation_Of_Bus_Routes"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <TextBlock FontSize="14" Text="Автоматизация автобусных рейсов" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="0"/>
        <Button FontSize="14" Content="Назад" HorizontalAlignment="Right" Name="BtnBack" Click="BtnBack_Click" Grid.Row="0"/>
        <Frame Name="MainFrame" NavigationUIVisibility="Hidden" ContentRendered="MainFrame_ContentRendered" Grid.Row="1"/>
    </Grid>
</Window>
