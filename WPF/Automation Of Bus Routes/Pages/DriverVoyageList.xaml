<Page x:Class="Automation_Of_Bus_Routes.Pages.DriverVoyageList"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Automation_Of_Bus_Routes.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="1200"
      Title="DriverVoyageList" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="DriverVoyageGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер рейса" Binding="{Binding Voyage.ID}" Width="*"/>
                <DataGridTextColumn Header="Компания" Binding="{Binding Voyage.NameCompany}" Width="*"/>
                <DataGridTextColumn Header="Номер маршрута" Binding="{Binding Voyage.Route.ID}" Width="*"/>
                <DataGridTextColumn Header="Пункт отправления" Binding="{Binding Voyage.Route.PointOfDeparture}" Width="*"/>
                <DataGridTextColumn Header="Пункт назначения" Binding="{Binding Voyage.Route.Destination}" Width="*"/>
                <DataGridTextColumn Header="Дата отправления" Binding="{Binding Voyage.DepartureDate}" Width="*"/>
                <DataGridTextColumn Header="Дата прибытия" Binding="{Binding Voyage.ArrivalDate}" Width="*"/>
                <DataGridTextColumn Header="Номер водителя в системе" Binding="{Binding Driver.ID}" Width="*"/>
                <DataGridTemplateColumn Header="ФИО водителя" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} {1} {2}">
                                        <Binding Path="Driver.LastName" />
                                        <Binding Path="Driver.FirstName" />
                                        <Binding Path="Driver.Patronymic" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактирование" Name="BtnEdit" Click="BtnEdit_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <DatePicker Width="100" Grid.Row="0" SelectedDateChanged="EndDatePicker_SelectedDateChanged" Name="end" Margin="424,5,226,5"></DatePicker>
        <DatePicker Width="100" Grid.Row="0" SelectedDateChanged="StartDatePicker_SelectedDateChanged" Name="start" Margin="225,5,425,5"></DatePicker>
        <TextBlock Grid.Row="0" Text="Сортировка по датам:   c" VerticalAlignment="Center" Margin="10,0,500,0"></TextBlock>
        <TextBlock Grid.Row="0" Text="по" VerticalAlignment="Center" Width="17" HorizontalAlignment="Center"></TextBlock>

        <TextBox Grid.Row="0" Width="200" Height="30" FontSize="14" Name="txtfilter1" TextChanged="txtFilter" VerticalAlignment="Center" HorizontalAlignment="Right"/>

        <Button FontSize="14" HorizontalAlignment="Left" Width="200" Grid.Row="2" Name="BtnAdd" Click="BtnAdd_Click"  Content="Добавить"/>
        <Button FontSize="14" HorizontalAlignment="Right" Width="200" Grid.Row="2" Name="BtnDel" Click="BtnDel_Click" Content="Удалить"/>
    </Grid>
</Page>
