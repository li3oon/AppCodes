<Page x:Class="Libraly.Pages.AddEditBookGenre"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Libraly.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddEditBookGenre">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <TextBlock Text="ISBN:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="0" Grid.Column="0"/>
        <TextBlock Text="Название:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="1" Grid.Column="0"/>
        <TextBlock Text="Фамилия автора:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="2" Grid.Column="0"/>
        <TextBlock Text="Имя автора:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="3" Grid.Column="0"/>
        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="4" ><Run Text="Отчество автора"/><LineBreak/><Run Text=" (необязательно):"/></TextBlock>
        <TextBlock Text="Год публикации:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="5" Grid.Column="0"/>
        <TextBlock Text="Издательство:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="6" Grid.Column="0"/>
        <TextBlock Text="Жанр:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="7" Grid.Column="0"/>

        <TextBox Name="ISBN" Grid.Row="0" Grid.Column="1" Width="300" Height="40" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10 0 0 0"/>
        <TextBox Name="NameBook" Grid.Row="1" Grid.Column="1" Width="300" Height="40" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10 0 0 0"/>
        <TextBox Name="AuthorLastName" Grid.Row="2" Grid.Column="1" Width="300" Height="40" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10 0 0 0"/>
        <TextBox Name="AuthorFirstName" Grid.Row="3" Grid.Column="1" Width="300" Height="40" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10 0 0 0"/>
        <TextBox Name="AuthorPatronymic" Grid.Row="4" Grid.Column="1" Width="300" Height="40" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10 0 0 0"/>
        <DatePicker Name="YearOfPublication" Grid.Row="5" Grid.Column="1" Width="300" Height="40" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10 0 0 0"/>
        <TextBox Name="Publisher" Grid.Row="6" Grid.Column="1" Width="300" Height="40" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10 0 0 0"/>
        <ComboBox x:Name="ComboNameGenre" DisplayMemberPath="NameGenre" SelectedValuePath="ID" Grid.Row="7" Grid.Column="1" Width="300" Height="40" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10 0 0 0"/>

        <Button FontSize="14" Content="Сохранить" Grid.ColumnSpan="2" Grid.Row="8" Name="BtnSave" HorizontalAlignment="Center" Click="BtnSave_Click"/>
    </Grid>
</Page>
