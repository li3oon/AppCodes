<Page x:Class="Libraly.Pages.AddEditReaderBook"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Libraly.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddEditReaderBook">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="0" Grid.Column="0"><Run Text="Номер читателя"/><LineBreak/><Run Text=" в системе:"/></TextBlock>
        <TextBlock Text="ISBN:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="1" Grid.Column="0"/>

        <ComboBox x:Name="ComboReaderID" DisplayMemberPath="ID" SelectedValuePath="ID" SelectedValue="{Binding ReaderID, Mode=TwoWay}" Grid.Row="0" Grid.Column="1" Width="300" Height="40" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10 0 0 0"/>
        <ComboBox x:Name="ComboBook" DisplayMemberPath="ISBN" SelectedValuePath="ISBN" SelectedValue="{Binding BookID, Mode=TwoWay}" Grid.Row="1" Grid.Column="1" Width="300" Height="40" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10 0 0 0"/>

        <Button FontSize="14" Content="Сохранить" Grid.ColumnSpan="2" Grid.Row="8" Name="BtnSave" HorizontalAlignment="Center" Click="BtnSave_Click"/>
    </Grid>
</Page>
