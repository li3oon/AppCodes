<Page x:Class="Network_of_Technical_Inspection_Stations.Services"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Network_of_Technical_Inspection_Stations"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Services" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="ServicesGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название услуги" Binding="{Binding NameService}" Width="*"/>
                <DataGridTextColumn Header="Описание услуги" Binding="{Binding DescriptionService}" Width="*"/>
                <DataGridTextColumn Header="Стоимость услуги" Binding="{Binding Cost}" Width="*"/>
                <DataGridTemplateColumn Width="auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактировать" Name="BtnEdit" Click="BtnEdit_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button HorizontalAlignment="Left" Width="200" Grid.Row="1" Name="BtnAddService" Click="BtnAddService_Click" Visibility="Collapsed" Content="Добавить услугу"/>
        <Button HorizontalAlignment="Right" Width="200" Grid.Row="1" Name="BtnDelService" Click="BtnDelService_Click" Visibility="Collapsed" Content="Удалить услугу"/>
    </Grid>
</Page>
