<Page x:Class="Network_of_Technical_Inspection_Stations.AddEditClientService"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Network_of_Technical_Inspection_Stations"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddEditClientService">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Номер клиента в системе:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="0" Grid.Column="0"/>
        <TextBlock Text="Оказанная услуга:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="1" Grid.Column="0"/>
        <TextBlock Text="Дата оказания услуги:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="2" Grid.Column="0"/>
        <TextBlock Text="Дата выполнения услуги:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="3" Grid.Column="0"/>
        <TextBlock Text="Статус услуги:" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Row="4" Grid.Column="0"/>

        <ComboBox x:Name="ComboClientID" DisplayMemberPath="ID" Grid.Column="1" Grid.Row="0" Height="30" Width="500" HorizontalAlignment="Left"/>
        <ComboBox x:Name="ComboNameService" DisplayMemberPath="NameService" Grid.Column="1" Grid.Row="1" Height="30" Width="500" HorizontalAlignment="Left"/>
        <DatePicker Text="{Binding CreatedDate}" Name="Date1" Width="100" Height="30" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Row="2" Grid.Column="1"/>
        <DatePicker Text="{Binding CompletedDate}" Name="Date2" Width="100" Height="30" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Row="3" Grid.Column="1"/>
        <ComboBox x:Name="ComboStatus" DisplayMemberPath="Progress" Grid.Column="1" Grid.Row="4" Height="30" Width="500" HorizontalAlignment="Left"/>

        <Button Content="Сохранить" Grid.ColumnSpan="2" Grid.Row="5" Name="BtnSaveClientService" HorizontalAlignment="Center" Click="BtnSaveClientService_Click"/>
    </Grid>
</Page>
