<Page x:Class="Network_of_Technical_Inspection_Stations.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Network_of_Technical_Inspection_Stations"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Login">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBox Name="UserLogin" Width="200" Height="50" FontSize="14" VerticalAlignment="Bottom" Grid.Row="0"/>
        <PasswordBox Name="UserPassword" Width="200" Height="50" FontSize="14" VerticalAlignment="Center" Grid.Row="2"/>
        <Button Name="BtnLogin" Click="BtnLogin_Click" Content="Войти" VerticalAlignment="Top" Grid.Row="4"/>
    </Grid>
</Page>
